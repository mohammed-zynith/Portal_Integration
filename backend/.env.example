# Database & Server
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/DB_NAME?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-here
FRONTEND_URL=https://finance.zynith-it.com

# Email Service Provider: 'office365', 'ses', or 'smtp'
EMAIL_PROVIDER=office365

# Office 365 / Microsoft Graph API Configuration
EMAIL_BACKEND=core.services.office365_email_backend.Office365EmailBackend
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
EMAIL_HOST_USER=admin@zynith-it.com
DEFAULT_FROM_EMAIL=admin@zynith-it.com
ALLOWED_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,zynith-it.com

# AWS S3 & SES Configuration (Fallback / Alternative)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=portals-storage-s3

# Legacy SMTP Configuration (Fallback)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=admin@zynith-it.com
EMAIL_PASS=your-app-password
